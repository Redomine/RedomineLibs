<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопоставить РН — выбор рабочего набора"
        Width="660" Height="480" MinWidth="440" MinHeight="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="Для этих файлов найдено несколько рабочих наборов. Выберите набор для каждого файла или оставьте «Пропустить»." />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="choice_rows" Margin="0,0,12,0" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="apply_button" Content="ОК" IsDefault="True"
                    MinWidth="90" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Отмена" IsCancel="True" MinWidth="90" Padding="12,4" />
        </StackPanel>
    </Grid>
</Window>
