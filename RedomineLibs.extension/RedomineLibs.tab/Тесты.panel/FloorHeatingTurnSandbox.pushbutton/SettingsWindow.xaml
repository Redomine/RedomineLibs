<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тёплый пол: настройки построения"
        Width="420" Height="485" MinWidth="390" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#FFF8FAFA" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="95" />
            <Setter Property="Height" Value="30" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="cancel_click" Margin="0,0,8,0" />
            <Button Content="Построить" Click="run_click" IsDefault="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="16"
                       Text="Параметры построения" Margin="0,0,0,12" />
            <TextBlock Text="Алгоритм" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,12">
                <RadioButton x:Name="spiral_radio"
                             GroupName="algorithm" Content="Улитка"
                             Margin="0,0,20,0" />
                <RadioButton x:Name="serpentine_radio"
                             GroupName="algorithm" Content="Змейка" />
            </StackPanel>
            <TextBlock Text="Направление построения" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,5,0,12">
                <RadioButton x:Name="counterclockwise_radio"
                             GroupName="direction" Content="Против часовой"
                             Margin="0,0,20,0" />
                <RadioButton x:Name="clockwise_radio"
                             GroupName="direction" Content="По часовой" />
            </StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Поворотов для каждой трубы" VerticalAlignment="Center" />
                <TextBox x:Name="turns_text" Grid.Column="1" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Общая предельная длина, м" VerticalAlignment="Center" />
                <TextBox x:Name="max_length_text" Grid.Column="1" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Отступ от области, мм" VerticalAlignment="Center" />
                <TextBox x:Name="offset_text" Grid.Column="1" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Шаг между трубами, мм" VerticalAlignment="Center" />
                <TextBox x:Name="spacing_text" Grid.Column="1" />
            </Grid>
            <CheckBox x:Name="blue_lines_check"
                      Content="Показывать отброшенные линии синим" />
            <CheckBox x:Name="save_journal_check" Margin="0,8,0,0"
                      Content="Сохранять журнал построения" />
            <TextBlock Margin="0,5,0,0" Foreground="#FF5A6666"
                       TextWrapping="Wrap"
                       Text="Настройки сохраняются в профиле pyRevit." />
        </StackPanel>
    </DockPanel>
</Window>
